  "THE_ARCHITECT.title": "The Architect",
  "THE_ARCHITECT.epithet": "",
  "VAKUU.title": "Vakuu",
  "VAKUU.epithet": "The First Demon",
  "ERROR.title": "Locked",
  "PROCEED.title": "Proceed",

  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-0.ancient": "[sine]..連合軍...指揮官...あなたの...技術...おそらく...燃え尽きる...だろう...しかし...あなたの...意志...永遠に...存続する...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-0.next": "応答",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-1.char": "連合軍は決して後退しない。私たちは前進する道の上のすべての障害を克服する。",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-1.next": "続行",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-2.ancient": "[sine]..よい...あなたの...信念...塔の中で...試される...だろう...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-2.next": "出発",

  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-0.ancient": "[sine]..あなた...戻ってきた...依然として...屹立している...あなたの...軍隊...学んだ...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-0.next": "応答",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-1.char": "すべての戦いが私たちを教える。すべての敗北が私たちを強くする。私たちは連合軍だ。",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-1.next": "続行",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-2.ancient": "[sine]..行け...あなたの...戦術...また...機会を...得た...[/sine]",

  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-0.ancient": "[sine]..3度目だ...あなたの...韌性...印象的だ...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-0.next": "応答",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-1.char": "韌性？これは私たちの標準的な作戦手順に過ぎない。",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-1.next": "続行",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-2.ancient": "[sine]..完璧だ...塔...あなたの...名前を...覚える...だろう...[/sine]",

  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-0.ancient": "[sine]..ソ連...指揮官...あなたの...火力...印象的だ...しかし...塔の...試練を...耐える...ことが...できるか...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-0.next": "応答",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-1.char": "ソ連は耐えられるかどうか問わない - 勝利を要求する！",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-1.next": "続行",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-2.ancient": "[sine]..情熱...炎だ...見てみよう...どれだけ...明るく...燃えるか...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-2.next": "出発",

  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-0.ancient": "[sine]..あなた...戻ってきた...依然として...怒りに...燃えている...あなたの...鉄の洪水...止められない...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-0.next": "応答",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-1.char": "ソ連軍は決して後退しない。すべての戦いが私たちを勝利に近づける。",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-1.next": "続行",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-2.ancient": "[sine]..行け...あなたの...燃える...炎...まだ...消えていない...[/sine]",

  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-0.ancient": "[sine]..3度目だ...あなたの...決意...不屈だ...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-0.next": "応答",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-1.char": "不屈だ？これがソ連の精神だ！",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-1.next": "続行",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-2.ancient": "[sine]..よい...あなたの...伝説...塔の中で...響き渡る...だろう...[/sine]",

  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-0r.ancient": "[red]連合軍[/red]。あなたの技術は印象的だが、避けられない崩壊からあなたを救うことはできない。",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-0r.next": "応答",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-1r.char": "避けられない？連合軍は常に道を見つける。私たちの知恵は無限だ！",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-1r.next": "続行",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-2r.ancient": "目的のない知恵は単なる騒音に過ぎない。",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-2r.next": "続行",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-3r.char": "私たちの目標は明確だ：世界に秩序と自由をもたらすこと！",

  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-0r.ancient": "[red]連合軍[/red]、あなたはおもちゃを握る子供のようにあなたの技術を握っている。",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-0r.next": "応答",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-1r.char": "技術は私たちの道具であり、杖ではない。そして私たちはそれをどう使うか知っている。",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-1r.next": "続行",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-2r.ancient": "それなら証明してみろ。あなたの'道具'が何ができるか見せてみろ。",

  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-0r.ancient": "[red]連合軍[/red]、あなたの粘り強さ...予想外だ。",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-0r.next": "応答",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-1r.char": "予想外だと？これが連合軍のやり方だ。私たちは適応し、克服し、勝利する。",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-1r.next": "続行",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-2r.ancient": "あなたの勝利が塔の頂上まで届くか見てみよう。",

  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-0r.ancient": "[red]ソ連[/red]。あなたの蛮力は塔の防御面前で粉々になるだろう。",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-0r.next": "応答",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-1r.char": "蛮力だと？これはソ連人民の力だ！私たちは私たちに反対するすべてを粉々にする！",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-1r.next": "続行",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-2r.ancient": "傲慢は力ではない。",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-2r.next": "続行",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-3r.char": "それなら本当に強いのは誰か見せてみろ！",

  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-0r.ancient": "[red]ソ連[/red]、あなたの火力は印象的だが精度に欠ける。",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-0r.next": "応答",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-1r.char": "精度か？私たちにはそれより良いものがある - 圧倒的な力！",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-1r.next": "続行",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-2r.ancient": "方向のない力は混乱に過ぎない。",

  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-0r.ancient": "[red]ソ連[/red]、あなたの決意...自分のやり方で...尊敬に値する。",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-0r.next": "応答",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-1r.char": "尊敬に値すると？私たちは尊敬を求めない。私たちは勝利を求める！",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-1r.next": "続行",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-2r.ancient": "それなら登れ。塔の頂上であなたの価値を証明してみろ。"
}