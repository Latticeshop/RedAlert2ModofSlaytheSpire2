{
  "DARV.title": "Darv",
  "DARV.epithet": "The Hoarder",
  "NEOW.title": "Neow",
  "NEOW.epithet": "Mother of Resurrection",
  "NONUPEIPE.title": "Nonupeipe",
  "NONUPEIPE.epithet": "Serendipity Incarnate",
  "OROBAS.title": "Orobas",
  "OROBAS.epithet": "Living Rainbow",
  "PAEL.title": "Pael",
  "PAEL.epithet": "Melting Dragon",
  "TANX.title": "Tanx",
  "TANX.epithet": "Khimera King",
  "TEZCATARA.title": "Tezcatara",
  "TEZCATARA.epithet": "It Which Feeds the Fire",
  "THE_ARCHITECT.title": "The Architect",
  "THE_ARCHITECT.epithet": "",
  "VAKUU.title": "Vakuu",
  "VAKUU.epithet": "The First Demon",
  "ERROR.title": "Locked",
  "PROCEED.title": "Proceed",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-0.ancient": "[sine]..commanders...of...the...Allies...your...technology...may...burn...but...your...will...endures...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-0.next": "Respond",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-1.char": "The Allied Forces never falter. We will overcome any obstacle in our path.",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-1.next": "Continue",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-2.ancient": "[sine]..good...your...conviction...will...be...tested...in...the...tower...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-2.next": "Depart",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-0.ancient": "[sine]..you...return...still...standing...your...army...has...learned...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-0.next": "Respond",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-1.char": "Every battle teaches us. Every defeat strengthens us. We are the Allies.",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-1.next": "Continue",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-2.ancient": "[sine]..go...your...tactics...have...earned...another...chance...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-0.ancient": "[sine]..third...time...your...resilience...is...remarkable...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-0.next": "Respond",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-1.char": "Resilience? This is merely our standard operating procedure.",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-1.next": "Continue",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-2.ancient": "[sine]..excellent...the...tower...will...remember...your...name...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-0.ancient": "[sine]..Soviet...commanders...your...firepower...is...impressive...but...can...you...endure...the...tower's...tests...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-0.next": "Respond",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-1.char": "The Soviet Union does not ask if it can endure - it demands victory!",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-1.next": "Continue",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-2.ancient": "[sine]..passion...is...a...flame...let...us...see...if...it...burns...bright...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-2.next": "Depart",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-0.ancient": "[sine]..you...return...still...raging...your...steel...avalanche...cannot...be...stopped...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-0.next": "Respond",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-1.char": "Soviet forces never retreat. Every battle brings us closer to triumph.",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-1.next": "Continue",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-2.ancient": "[sine]..go...your...fire...has...not...been...extinguished...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-0.ancient": "[sine]..third...time...your...determination...is...unbreakable...[/sine]",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-0.next": "Respond",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-1.char": "Unbreakable? This is the spirit of the Soviet Union!",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-1.next": "Continue",
  "NEOW.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-2.ancient": "[sine]..good...your...legacy...will...echo...through...the...tower...[/sine]",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-0r.ancient": "[red]Allied Forces[/red]. Your technology is impressive, but it cannot save you from the inevitable collapse.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-0r.next": "Respond",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-1r.char": "Inevitable? The Allies always find a way. Our ingenuity knows no bounds!",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-1r.next": "Continue",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-2r.ancient": "Ingenuity without purpose is just noise.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-2r.next": "Continue",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.0-3r.char": "Our purpose is clear: to bring order and freedom to the world!",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-0r.ancient": "[red]Allied Forces[/red], you cling to your technology like a child clings to a toy.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-0r.next": "Respond",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-1r.char": "Technology is our tool, not our crutch. And we know how to use it.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-1r.next": "Continue",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.1-2r.ancient": "Then prove it. Show me what your 'tools' can do.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-0r.ancient": "[red]Allied Forces[/red], your persistence is... unexpected.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-0r.next": "Respond",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-1r.char": "Unexpected? This is what the Allies do. We adapt, we overcome, we win.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-1r.next": "Continue",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_ALLIES.2-2r.ancient": "We shall see if your victory extends to the tower's summit.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-0r.ancient": "[red]Soviet Union[/red]. Your brute force will shatter against the tower's defenses.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-0r.next": "Respond",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-1r.char": "Brute force? This is the might of the Soviet people! We will crush all who oppose us!",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-1r.next": "Continue",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-2r.ancient": "Arrogance is not strength.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-2r.next": "Continue",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.0-3r.char": "Then let us see who is truly strong!",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-0r.ancient": "[red]Soviet Union[/red], your firepower is impressive, but it lacks precision.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-0r.next": "Respond",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-1r.char": "Precision? We have something better - overwhelming force!",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-1r.next": "Continue",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.1-2r.ancient": "Force without direction is chaos.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-0r.ancient": "[red]Soviet Union[/red], your determination is... admirable, in its own way.",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-0r.next": "Respond",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-1r.char": "Admirable? We do not seek admiration. We seek victory!",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-1r.next": "Continue",
  "THE_ARCHITECT.talk.RED_ALERT2_MOD_CHARACTER_SOVIET.2-2r.ancient": "Then climb. Prove your worth at the tower's summit."
}